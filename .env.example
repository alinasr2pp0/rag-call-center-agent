
# === Embeddings (Voyage AI) — API key required ===
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# === Vector DB (Pinecone) — API key required ===
PINECONE_API_KEY=
PINECONE_INDEX_NAME=call-center-kb
PINECONE_ENVIRONMENT=us-east-1-aws

# === LLM (OpenRouter) — API key required ===
OPENROUTER_API_KEY=
LLM_MODEL_PRIMARY=openai/gpt-4o
LLM_MODEL_FALLBACKS=["meta-llama/llama-3.1-70b-instruct","mistralai/mixtral-8x7b"]

# === Web search fallback (Tavily) — API key required (has a free tier) ===
TAVILY_API_KEY=

# === Telephony (Vonage Voice API) ===
# . Sign up at dashboard.nexmo.com (free trial, no card, ~$2 credit).
# . Create a Voice-enabled Application: Applications > Create a new application.
# .  VONAGE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
# . Buy/rent a Vonage virtual number (or use a trial one) for VONAGE_FROM_NUMBER.
# . During trial: verify your own number and (if you want live transfer to work)
#    the agent's number too, from the dashboard — trial calls only reach verified numbers.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_FROM_NUMBER=201000000000        # digits only, no "+"
PUBLIC_BASE_URL=http://localhost:8000  # run `ngrok http 8000` and paste the https URL here
HUMAN_AGENT_TRANSFER_NUMBER=201000000001  # digits only, no "+" — replace with your real escalation line

# === Database — SQLite by default (zero install, just a local file) ===
# Fine for local dev/testing. Swap to Postgres before production (SQLite
# doesn't handle concurrent writes from multiple simultaneous requests well):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/call_center_rag
DATABASE_URL=sqlite+aiosqlite:///./call_center_rag.db

# === Staff auth (Admin dashboard + KB management) ===
JWT_SECRET=271ff08622e8a4a4164706a83f07bddafeb60884b0521dc66ad7e232713045d1
JWT_EXPIRE_MINUTES=480
# Bootstraps the very first account as superadmin (top of the staff
# hierarchy) if none exists yet - use it to create further admin/agent
# accounts via POST /staff, then change this password.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=changeme123

# === Business rules (already set to your confirmed values) ===
FOLLOWUP_CALL_DELAY_SECONDS=180
MAX_RESOLUTION_ATTEMPTS=3

# === Call retry (no-answer/busy/failed) ===
MAX_CALL_RETRIES=2
CALL_RETRY_DELAY_SECONDS=60
CALL_DISPATCH_POLL_SECONDS=10

# === CORS — fine wide-open for local dev ===
ALLOWED_ORIGINS=*

# === Deployment safety ===
ENVIRONMENT=development
